# ---- Images ----
# GitHub user/org that owns the images (lowercase), e.g. ghcr.io/<GHCR_OWNER>/booking-tracker-api
GHCR_OWNER=your-github-username
# Branch tag to deploy: main or uat
IMAGE_TAG=main

# ---- Host ports ----
API_PORT=5145
WEB_PORT=3000

# ---- API ----
# External PostgreSQL. Use host.docker.internal if Postgres runs on this Docker host.
DB_CONNECTION_STRING=Host=your-postgres-host;Port=5432;Database=bookingconfimraitondb;Username=postgres;Password=CHANGE_ME
# Old single-site settings: only used on the first start with no sites, to create a "default" site.
# Sites (lead/sale/both, postback URLs, webhook secret, website) are managed in the admin → Sites.
TRACKCREST_POSTBACK_URL=
ZYLUX_WEBHOOK_SECRET=
TRACKING_ALLOWED_ORIGIN=https://dept.habyyer.com
TRACKING_REQUIRE_WEBHOOK_CONFIRMATION=true
ENABLE_SWAGGER=false

# ---- Shared ----
# Same value is used by the API (Admin__ApiKey) and the web app. `openssl rand -hex 24`
ADMIN_API_KEY=

# ---- Web ----
# Public HTTPS URL of the API (used by tracker.js in browsers)
API_PUBLIC_URL=https://api.example.com
# Public HTTPS URL of the web app
APP_PUBLIC_URL=https://track.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# `openssl rand -hex 32`
SESSION_SECRET=
BRAND_NAME=Dept Global Solutions
BRAND_SITE_URL=https://dept.habyyer.com
ZYLUX_BASE_URL=https://meet.zyluxmedia.app
ADMIN_TIMEZONE=Africa/Lagos
ENABLE_DEMO=false
