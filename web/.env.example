# Server-to-server URL of the .NET API (used by the admin)
API_BASE_URL=http://localhost:5145
# Public URL of the .NET API (used by tracker.js in visitors' browsers and shown on the Setup page).
# Optional: leave empty to reuse API_BASE_URL when the API has only one (public) address.
API_PUBLIC_URL=https://api.example.com
# Public URL of this Next.js app (hosts tracker.js and /booking-confirmed).
# Optional: if empty it is taken from the request host. Set it in production (behind proxies/CDNs).
APP_PUBLIC_URL=https://track.example.com
# Must equal Admin:ApiKey in the API settings
ADMIN_API_KEY=
# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Shown on the booking confirmation page
BRAND_NAME=Dept Global Solutions
BRAND_SITE_URL=https://dept.habyyer.com
ZYLUX_BASE_URL=https://meet.zyluxmedia.app
# Optional: embed the real Zylux scheduler on /demo (dev only)
ZYLUX_BOOKING_PATH=
# Time zone for dates in the admin
ADMIN_TIMEZONE=Africa/Lagos
# Set to true to allow /demo in production
ENABLE_DEMO=false
